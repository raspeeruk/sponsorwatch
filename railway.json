{
  "$schema": "https://railway.com/railway.schema.json",
  "build": {
    "builder": "RAILPACK",
    "buildCommand": "npm run build",
    "watchPatterns": [
      "src/**",
      "scripts/**",
      "public/**",
      "package.json",
      "package-lock.json",
      "next.config.ts",
      "railway.json",
      ".data-refresh/**",
      "tsconfig.json",
      "tailwind.config.ts",
      "postcss.config.mjs"
    ]
  },
  "deploy": {
    "startCommand": "npm run start",
    "restartPolicyType": "ON_FAILURE",
    "restartPolicyMaxRetries": 3,
    "healthcheckPath": "/",
    "healthcheckTimeout": 300
  }
}
